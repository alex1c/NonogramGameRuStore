{
  "expo": {
    "name": "Японские кроссворды — Нонограммы",
    "slug": "nonogram-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_gpt.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nonogram",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calculatorplatform.nonogram",
      "icon": "./assets/icon_gpt.png"
    },
    "android": {
      "package": "com.calculatorplatform.nonogram",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E7EEE4",
        "foregroundImage": "./assets/icon_gpt.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon_gpt.png"
    },
    "plugins": [
      "expo-dev-client"
    ]
  }
}
